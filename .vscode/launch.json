{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ST-Link 烧录并调试 STM32",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      // 改为你实际编译输出的 elf 文件路径
      "executable": "${workspaceFolder}/build/Debug/flight.elf",
      
      "device": "STM32F103C8",
      "interface": "swd",
      // OpenOCD 配置文件，对应 ST-Link 和 STM32F1 系列
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      // 烧录后自动运行到 main 函数
      "runToEntryPoint": "main"
    }
  ]
}